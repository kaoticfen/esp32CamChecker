{
  "name": "esp32camchecker-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local hub that aggregates ESP32-CAM cameras behind one mobile web page",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "start": "node src/server/main.ts",
    "test": "node tools/e2e-test.mjs",
    "mock-camera": "node tools/mock-camera.mjs",
    "reset-password": "node tools/reset-password.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
