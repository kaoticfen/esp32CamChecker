# Copy to .env and edit. Never commit the real file.
#   cp .env.example .env

# --- Listener ----------------------------------------------------------------
HUB_HOST=0.0.0.0
# Defaults to 8080 without TLS, 8443 with it.
HUB_PORT=8443

# --- First login -------------------------------------------------------------
# Used only when the database has no users yet. Leave ADMIN_PASSWORD unset and
# the hub generates one and prints it once to the log:
#   docker compose logs hub | grep "generated password"
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Sessions ----------------------------------------------------------------
# 32+ characters. If unset, one is generated and kept in /data/session.secret,
# which is fine -- set it explicitly only if you want logins to survive a wipe
# of the data volume.
SESSION_SECRET=
SESSION_TTL_HOURS=720

# --- TLS ---------------------------------------------------------------------
# Generated with mkcert; see docs/SETUP.md. Comment both out to serve plain
# HTTP (fine if you only ever reach the hub over Tailscale).
TLS_CERT_FILE=/certs/hub.pem
TLS_KEY_FILE=/certs/hub-key.pem

# --- Behaviour ---------------------------------------------------------------
# Cameras heartbeat every 30s; this is how long silence means "offline".
OFFLINE_AFTER_SECONDS=100
PAIRING_CODE_TTL_MINUTES=10
LOG_LEVEL=info
